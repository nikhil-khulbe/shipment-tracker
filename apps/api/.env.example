# Copy to .env for local development. Never commit the real .env.
NODE_ENV=development
PORT=4000

# mongodb://localhost:27017/shipment_tracker for local mongod,
# or an Atlas SRV string for the hosted cluster.
MONGODB_URI=mongodb://localhost:27017/shipment_tracker

# 32+ random bytes. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# true (default) = admin operations need a login. false = open demo mode where
# anyone can create/update shipments. Leave unset in production.
REQUIRE_ADMIN=true

# Rate limits per IP per 15 minutes (optional).
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Comma-separated list of allowed browser origins (web build / Apollo Sandbox).
CORS_ORIGIN=http://localhost:19006,http://localhost:8081

# Only needed when running `npm run seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
# Optional: also create a DRIVER (can update statuses, nothing else).
# SEED_DRIVER_EMAIL=driver@example.com
# SEED_DRIVER_PASSWORD=change-me-too
